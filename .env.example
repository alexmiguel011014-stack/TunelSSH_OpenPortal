# Nenhuma dessas variáveis é obrigatória — o app roda com os defaults abaixo
# sem precisar de um .env. Documentadas aqui só pra referência.

# development | production (controla intervalo de update e libera 127.0.0.1/
# localhost no net-guard). Setado automaticamente pelo script "dev".
NODE_ENV=development

# Intervalo (ms) entre checagens de atualização automática.
# Default: 5min em dev, 15min em produção.
OPENPORTAL_UPDATE_INTERVAL_MS=900000

# Se "false", ignora pre-releases do GitHub ao checar atualização.
# Default: true (aceita pre-release/dev build).
OPENPORTAL_ALLOW_PRERELEASE=true

# Contas com Supabase (GOALS 20). Sem as duas variáveis o app roda sem login, como antes.
# Valem para o desenvolvimento e para o `npm run build` (o instalador leva os valores do build).
# Painel do Supabase > Project Settings > API: o endereço do projeto e a chave PUBLISHABLE.
# A chave publishable é pública por desenho (a segurança está nas regras do banco); a chave
# SECRET / service_role NUNCA entra aqui — o build recusa essa chave.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
